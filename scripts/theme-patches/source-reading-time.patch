diff --git a/assets/css/reading-time.css b/assets/css/reading-time.css
new file mode 100644
index 0000000..ff31309
--- /dev/null
+++ b/assets/css/reading-time.css
@@ -0,0 +1,25 @@
+.gh-card-reading-time {
+    display: inline-flex;
+    align-items: center;
+    gap: 10px;
+    margin: 0 0 12px;
+    padding: 6px 10px;
+    background: #080808;
+    color: #c5a059;
+    font-family: var(--font-mono);
+    font-size: 14px;
+    line-height: 1.6;
+}
+
+.gh-card-reading-time::before {
+    content: "";
+    width: clamp(16px, calc(var(--reading-minutes, 1) * 4px), 80px);
+    height: 1px;
+    background: currentColor;
+}
+
+.home-template .gh-card-link:focus-visible {
+    outline: 2px solid #f2f2f2;
+    outline-offset: 4px;
+    box-shadow: 0 0 0 6px #080808;
+}
